#include <ESP32Servo.h>

// ===== SERVO SIGNAL PINS =====
const int PIN_SERVO1 = 23;  // MG90S
const int PIN_SERVO2 = 32;  // MG90S
const int PIN_SERVO3 = 33;  // MG996R

// ===== SERVO OBJECTS =====
Servo servo1;
Servo servo2;
Servo servo3;

// ===== SERVO ANGLES =====
int angle1 = 90;
int angle2 = 90;
int angle3 = 90;

void setup() {
  Serial.begin(115200);

  // Configure servo PWM frequency
  servo1.setPeriodHertz(50);
  servo2.setPeriodHertz(50);
  servo3.setPeriodHertz(50);

  // Attach each servo to its GPIO pin
  servo1.attach(PIN_SERVO1, 500, 2400);
  servo2.attach(PIN_SERVO2, 500, 2400);
  servo3.attach(PIN_SERVO3, 500, 2500);

  // Start at the center position
  servo1.write(angle1);
  servo2.write(angle2);
  servo3.write(angle3);

  delay(1500);

  Serial.println("MagnetRieve Servo Test Started");
  Serial.println("All three servos should move.");
}

void loop() {
  // Move all servos to 60 degrees
  Serial.println("Moving to 60 degrees");

  servo1.write(60);
  servo2.write(60);
  servo3.write(60);

  delay(2000);

  // Move all servos to 120 degrees
  Serial.println("Moving to 120 degrees");

  servo1.write(120);
  servo2.write(120);
  servo3.write(120);

  delay(2000);

  // Return all servos to 90 degrees
  Serial.println("Returning to 90 degrees");

  servo1.write(90);
  servo2.write(90);
  servo3.write(90);

  delay(2000);
}
