// ---- State ----
float    targetLeft = 0, targetRight = 0;
float    currentLeft = 0, currentRight = 0;
String   stateName = "stop";
bool     estop = false;
uint32_t lastCommandMs = 0;
uint32_t lastTickMs = 0;

float    armCurrent = ARM_STOW_ANGLE;
float    armTarget  = ARM_STOW_ANGLE;
String   armPosName = "stow";

bool     magnetOn = false;
bool     magnetTimedOut = false;
uint32_t magnetOnSinceMs = 0;

