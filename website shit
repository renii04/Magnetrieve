// ---- Driving ----
const int      DEFAULT_SPEED     = 70;      // % when a request has no speed
const float    TURN_SCALE        = 0.80f;   // pivot-turn power relative to speed
const int      MIN_PWM           = 90;      // lowest duty that still moves the motors (0-255)
const int      MAX_PWM           = 255;     // top duty (lower to cap max speed)
const float    RAMP_PCT_PER_TICK = 5.0f;    // acceleration limit per tick (higher = snappier)
const uint32_t COMMAND_TIMEOUT_MS = 500;    // failsafe stop, 0 disables
const float    MAX_SPEED_MPS     = 0.50f;   // measured top speed (dashboard readout only)
const uint32_t PWM_FREQ          = 1000;    // motor PWM, Hz
const uint8_t  PWM_RES           = 8;       // motor PWM, bits

// ---- Motors (one L298N, two channels, each driving a pair in parallel) ----
//   name   IN1 IN2 EN  PWM-ch leftSide invert trim
//   invert: flip if that side runs backward   trim: lower (0..1) if the robot drifts
struct Motor {
  const char* name;
  uint8_t in1, in2, en;
  uint8_t channel;
  bool    leftSide;
  bool    invert;
  float   trim;
};

Motor motors[] = {
  {"left",  26, 27, 25, 0, true,  false, 1.0f},
  {"right", 14, 12, 13, 1, false, false, 1.0f},   // GPIO12 is a strapping pin; use 33 if boot problems
};

// ---- Robotic arm (180-degree servo) ----
const int      SERVO_PIN          = 18;
const uint8_t  SERVO_CHANNEL      = 2;       // used on core 2.x only
const int      SERVO_MIN_US       = 500;     // pulse for 0 degrees   (SG90/MG996R: ~500)
const int      SERVO_MAX_US       = 2400;    // pulse for 180 degrees (~2400-2500)
const bool     ARM_INVERT         = false;   // flip servo direction
const float    ARM_MIN_ANGLE      = 0;       // mechanical limits
const float    ARM_MAX_ANGLE      = 180;
const float    ARM_SPEED_DPS      = 90.0f;   // arm travel speed, degrees per second
// Presets used by the dashboard buttons:
const float    ARM_STOW_ANGLE     = 0;       // folded / home (0% extension)
const float    ARM_RAISE_ANGLE    = 60;
const float    ARM_BIN_ANGLE      = 130;     // above the collector bin
const float    ARM_LOWER_ANGLE    = 180;     // down to the ground (100% extension)

// ---- Electromagnet ----
const int      MAGNET_PIN         = 23;
const bool     MAGNET_ACTIVE_HIGH = true;    // many relay modules are ACTIVE LOW: set false
const uint32_t MAGNET_MAX_ON_MS   = 60000;   // auto-off, 0 disables
const bool     ESTOP_RELEASES_MAGNET = false; // true = emergency stop also drops the load

// ---- Metal sensor ----
const int      METAL_DIGITAL_PIN  = 34;      // -1 to disable
const bool     METAL_ACTIVE_HIGH  = true;    // level when metal is detected
const int      METAL_ANALOG_PIN   = 35;      // -1 to disable (use ADC1 pins 32-39 only; ADC2 breaks with Wi-Fi)
const uint32_t METAL_DEBOUNCE_MS  = 40;

// ---- Detector sweep (drives forward slowly until metal is found) ----
const int      SWEEP_SPEED        = 35;      // %
const uint32_t SWEEP_TIMEOUT_MS   = 10000;   // give up after this long

const uint32_t TICK_MS            = 20;      // ramp / arm update period
const bool     DEBUG_SERIAL       = true;

