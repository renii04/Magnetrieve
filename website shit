const char *b(bool v) { return v ? "true" : "false"; }

String statusJson() {
  float speedPct = (fabsf(currentLeft) + fabsf(currentRight)) / 2.0f;
  String j = "{";
  j += "\"estop\":";        j += b(estop);
  j += ",\"state\":\"";     j += stateName; j += "\"";
  j += ",\"leftPct\":";     j += String(currentLeft, 1);
  j += ",\"rightPct\":";    j += String(currentRight, 1);
  j += ",\"speedPct\":";    j += String(speedPct, 1);
  j += ",\"speedMps\":";    j += String(speedPct / 100.0f * MAX_SPEED_MPS, 2);
  j += ",\"armAngle\":";    j += String(armCurrent, 1);
  j += ",\"armTarget\":";   j += String(armTarget, 1);
  j += ",\"armPos\":\"";    j += armPosName; j += "\"";
  j += ",\"extensionPct\":"; j += String(extensionPct(), 0);
  j += ",\"magnet\":";      j += b(magnetOn);
  j += ",\"magnetTimedOut\":"; j += b(magnetTimedOut);
  j += ",\"metal\":";       j += b(metalDetected);
  j += ",\"metalFound\":";  j += b(metalFound);
  j += ",\"metalLevel\":";  j += String(metalLevel);
  j += ",\"sweeping\":";    j += b(sweeping);
  j += ",\"rssi\":";        j += String(WiFi.RSSI());
  j += ",\"uptimeMs\":";    j += String(millis());
  j += "}";
  return j;
}

// ---------------------------------------------------------------------
//  HTTP
// ---------------------------------------------------------------------
void addCors() {
  server.sendHeader("Access-Control-Allow-Origin",  ALLOWED_ORIGIN);
  server.sendHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
  server.sendHeader("Access-Control-Allow-Headers", "Content-Type");
  server.sendHeader("Access-Control-Allow-Private-Network", "true");
  server.sendHeader("Cache-Control", "no-store");
}

void sendJson(int code, const String &body) {
  addCors();
  server.send(code, "application/json", body);
}

void sendError(int code, const char *msg) {
  sendJson(code, String("{\"error\":\"") + msg + "\"}");
}

void reply(const Result &r) {
  if (r.code == 200) sendJson(200, statusJson());
  else               sendError(r.code, r.msg);
}

void hStatus() { sendJson(200, statusJson()); }
void hMove()   { reply(doMove(server.arg("dir"), server.hasArg("speed") ? server.arg("speed").toInt() : DEFAULT_SPEED)); }
void hDrive()  {
  if (!server.hasArg("left") || !server.hasArg("right")) { sendError(400, "need left and right (-100..100)"); return; }
  reply(doDrive(server.arg("left").toFloat(), server.arg("right").toFloat()));
}
void hArm() {
  if (server.hasArg("angle")) reply(doArmAngle(server.arg("angle").toFloat()));
  else                        reply(doArmPreset(server.arg("pos")));
}
void hMagnet() { reply(doMagnet(server.arg("state"))); }
void hSweep()  { reply(doSweep(server.arg("state"))); }
void hStop()   { reply(doEstop()); }
void hResume() { reply(doResume()); }
void hRoot()   { addCors(); server.send(200, "text/plain", "Magnetretrieve robot online. Try /api/status"); }

void handlePreflight() {
  addCors();
  server.send(204, "text/plain", "");
}

void route(const char *path, void (*handler)()) {
  server.on(path, HTTP_ANY, [handler]() {
    if (server.method() == HTTP_OPTIONS) { handlePreflight(); return; }
    handler();
  });
}

// ---------------------------------------------------------------------
//  Bluetooth LE (Nordic UART service)
// ---------------------------------------------------------------------
#if ENABLE_BLE
#define NUS_SERVICE "6e400001-b5a3-f393-e0a9-e50e24dcca9e"
#define NUS_RX      "6e400002-b5a3-f393-e0a9-e50e24dcca9e"   // phone/web writes here
#define NUS_TX      "6e400003-b5a3-f393-e0a9-e50e24dcca9e"   // robot notifies here
#define BLE_CMD_MAX 48
#define BLE_CHUNK   20

BLECharacteristic *txChar = nullptr;
QueueHandle_t      bleQueue = nullptr;
volatile bool      bleConnected = false;
volatile bool      bleRestartAdv = false;
uint32_t           lastBleStatusMs = 0;

class ServerCb : public BLEServerCallbacks {
  void onConnect(BLEServer *) override    { bleConnected = true; }
  void onDisconnect(BLEServer *) override { bleConnected = false; bleRestartAdv = true; }
};

class RxCb : public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic *c) override {
    auto v = c->getValue();
    char buf[BLE_CMD_MAX];
    memset(buf, 0, sizeof(buf));
    strncpy(buf, v.c_str(), BLE_CMD_MAX - 1);
    xQueueSend(bleQueue, buf, 0);          // handled in loop(), not in the BLE task
  }
};

void bleSend(const String &msg) {
  if (!bleConnected || !txChar) return;
  String out = msg + "\n";
  for (size_t i = 0; i < out.length(); i += BLE_CHUNK) {
    String part = out.substring(i, i + BLE_CHUNK);
    txChar->setValue((uint8_t *)part.c_str(), part.length());
    txChar->notify();
    delay(4);
  }
}

void bleSetup() {
  bleQueue = xQueueCreate(8, BLE_CMD_MAX);
  BLEDevice::init(BLE_NAME);
  BLEServer *srv = BLEDevice::createServer();
  srv->setCallbacks(new ServerCb());

  BLEService *svc = srv->createService(NUS_SERVICE);
  txChar = svc->createCharacteristic(NUS_TX, BLECharacteristic::PROPERTY_NOTIFY);
#if ESP_ARDUINO_VERSION_MAJOR < 3
  txChar->addDescriptor(new BLE2902());
#endif
  BLECharacteristic *rx = svc->createCharacteristic(
      NUS_RX, BLECharacteristic::PROPERTY_WRITE | BLECharacteristic::PROPERTY_WRITE_NR);
  rx->setCallbacks(new RxCb());
  svc->start();

  BLEAdvertising *adv = BLEDevice::getAdvertising();
  adv->addServiceUUID(NUS_SERVICE);
  adv->setScanResponse(true);
  BLEDevice::startAdvertising();
  Serial.printf("BLE advertising as \"%s\"\n", BLE_NAME);
}

void bleLoop(uint32_t now) {
  char buf[BLE_CMD_MAX];
  while (xQueueReceive(bleQueue, buf, 0) == pdTRUE) {
    String line(buf);
    line.trim();
    line.toLowerCase();
    if (line == "status") {
      bleSend(statusJson());
    } else {
      Result r = runCommand(line);
      bleSend(r.code == 200 ? String("OK") : String("ERR ") + r.msg);
    }
  }

  if (bleRestartAdv) {
    bleRestartAdv = false;
    delay(200);
    BLEDevice::startAdvertising();
  }

  if (bleConnected && BLE_STATUS_INTERVAL_MS > 0 && now - lastBleStatusMs >= BLE_STATUS_INTERVAL_MS) {
    lastBleStatusMs = now;
    bleSend(statusJson());
  }
}
#endif

// ---------------------------------------------------------------------
//  Wi-Fi
// ---------------------------------------------------------------------
void connectWifi() {
  WiFi.mode(WIFI_STA);
  WiFi.setHostname(HOSTNAME);
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASS);

  Serial.printf("Connecting to %s", WIFI_SSID);
  uint32_t start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < WIFI_TIMEOUT_MS) {
    delay(300);
    Serial.print(".");
  }
  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("Connected. IP: ");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("Wi-Fi failed - starting fallback hotspot");
    WiFi.mode(WIFI_AP);
    WiFi.softAP(AP_SSID, AP_PASS);
    Serial.print("Hotspot IP: ");
    Serial.println(WiFi.softAPIP());
  }

  if (MDNS.begin(HOSTNAME)) Serial.printf("mDNS: http://%s.local\n", HOSTNAME);
}

// ---------------------------------------------------------------------
//  Sensors / periodic updates
// ---------------------------------------------------------------------
void updateMetal(uint32_t now) {
  if (METAL_DIGITAL_PIN >= 0) {
    bool raw = (digitalRead(METAL_DIGITAL_PIN) == (METAL_ACTIVE_HIGH ? HIGH : LOW));
    if (raw != metalRaw) { metalRaw = raw; metalChangedMs = now; }
    if (now - metalChangedMs >= METAL_DEBOUNCE_MS) metalDetected = metalRaw;
  }
  if (METAL_ANALOG_PIN >= 0) metalLevel = analogRead(METAL_ANALOG_PIN);
}

void updateSweep(uint32_t now) {
  if (!sweeping) return;
  lastCommandMs = now;                       // sweep is autonomous, keep failsafe quiet
  if (metalDetected) {
    sweeping = false;
    metalFound = true;
    setDrive(0, 0, "metal-found");
  } else if (now - sweepStartMs > SWEEP_TIMEOUT_MS) {
    sweeping = false;
    setDrive(0, 0, "stop");
  }
}

void updateMagnetSafety(uint32_t now) {
  if (magnetOn && MAGNET_MAX_ON_MS > 0 && now - magnetOnSinceMs > MAGNET_MAX_ON_MS) {
    setMagnet(false);
    magnetTimedOut = true;
    if (DEBUG_SERIAL) Serial.println("Magnet auto-off (timeout)");
  }
}

void updateFailsafe(uint32_t now) {
  if (COMMAND_TIMEOUT_MS > 0 && !estop &&
      (targetLeft != 0 || targetRight != 0) &&
      now - lastCommandMs > COMMAND_TIMEOUT_MS) {
    targetLeft = targetRight = 0;
    stateName = "stop";
    if (DEBUG_SERIAL) Serial.println("Failsafe: command timeout");
  }
}

void tick() {
  currentLeft  = stepToward(currentLeft,  targetLeft,  RAMP_PCT_PER_TICK);
  currentRight = stepToward(currentRight, targetRight, RAMP_PCT_PER_TICK);
  applyOutputs();

  armCurrent = stepToward(armCurrent, armTarget, ARM_SPEED_DPS * (TICK_MS / 1000.0f));
  servoWriteAngle(armCurrent);
}

// ---------------------------------------------------------------------
//  Arduino entry points
// ---------------------------------------------------------------------
void setup() {
  Serial.begin(115200);
  delay(200);

  // Motors
  for (size_t i = 0; i < MOTOR_COUNT; i++) {
    pinMode(motors[i].in1, OUTPUT);
    pinMode(motors[i].in2, OUTPUT);
    pwmBegin(motors[i]);
  }
  hardStop();

  // Magnet (start OFF)
  pinMode(MAGNET_PIN, OUTPUT);
  setMagnet(false);

  // Arm (assumes the arm is stowed at power-on)
  servoBegin();
  servoWriteAngle(armCurrent);

  // Metal sensor
  if (METAL_DIGITAL_PIN >= 0) pinMode(METAL_DIGITAL_PIN, INPUT);
  if (METAL_ANALOG_PIN  >= 0) pinMode(METAL_ANALOG_PIN,  INPUT);

  connectWifi();
#if ENABLE_BLE
  bleSetup();
#endif

  route("/",           hRoot);
  route("/api/status", hStatus);
  route("/api/move",   hMove);
  route("/api/drive",  hDrive);
  route("/api/arm",    hArm);
  route("/api/magnet", hMagnet);
  route("/api/sweep",  hSweep);
  route("/api/stop",   hStop);
  route("/api/resume", hResume);
  server.onNotFound([]() {
    if (server.method() == HTTP_OPTIONS) { handlePreflight(); return; }
    sendError(404, "not found");
  });
  server.begin();

  lastCommandMs = millis();
  Serial.println("Robot ready.");
}

void loop() {
  server.handleClient();

  uint32_t now = millis();

#if ENABLE_BLE
  bleLoop(now);
#endif

  updateMetal(now);
  updateSweep(now);
  updateMagnetSafety(now);
  updateFailsafe(now);

  if (now - lastTickMs >= TICK_MS) {
    lastTickMs = now;
    tick();
  }
}
