// ---------------------------------------------------------------------
//  PWM helpers (core 2.x and 3.x)
// ---------------------------------------------------------------------
void pwmBegin(const Motor &m) {
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcAttach(m.en, PWM_FREQ, PWM_RES);
#else
  ledcSetup(m.channel, PWM_FREQ, PWM_RES);
  ledcAttachPin(m.en, m.channel);
#endif
}

void pwmWrite(const Motor &m, uint32_t duty) {
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcWrite(m.en, duty);
#else
  ledcWrite(m.channel, duty);
#endif
}

void servoBegin() {
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcAttach(SERVO_PIN, 50, 16);
#else
  ledcSetup(SERVO_CHANNEL, 50, 16);
  ledcAttachPin(SERVO_PIN, SERVO_CHANNEL);
#endif
}

void servoWriteAngle(float angle) {
  angle = constrain(angle, 0.0f, 180.0f);
  if (ARM_INVERT) angle = 180.0f - angle;
  float us = SERVO_MIN_US + (angle / 180.0f) * (SERVO_MAX_US - SERVO_MIN_US);
  uint32_t duty = (uint32_t)(us * 65535.0f / 20000.0f);   // 50 Hz = 20000 us, 16-bit
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcWrite(SERVO_PIN, duty);
#else
  ledcWrite(SERVO_CHANNEL, duty);
#endif
}

// ---------------------------------------------------------------------
//  Low-level control
// ---------------------------------------------------------------------
void driveMotor(const Motor &m, float pct) {
  pct = constrain(pct, -100.0f, 100.0f);
  if (m.invert) pct = -pct;

  bool  forward = pct >= 0;
  float mag     = fabsf(pct) * m.trim;

  uint32_t duty = 0;
  if (mag >= 1.0f) {
    duty = MIN_PWM + (uint32_t)((mag / 100.0f) * (MAX_PWM - MIN_PWM));
    if (duty > (uint32_t)MAX_PWM) duty = MAX_PWM;
  }

  if (duty == 0) {
    digitalWrite(m.in1, LOW);
    digitalWrite(m.in2, LOW);
  } else {
    digitalWrite(m.in1, forward ? HIGH : LOW);
    digitalWrite(m.in2, forward ? LOW : HIGH);
  }
  pwmWrite(m, duty);
}

void applyOutputs() {
  for (size_t i = 0; i < MOTOR_COUNT; i++) {
    driveMotor(motors[i], motors[i].leftSide ? currentLeft : currentRight);
  }
}

float stepToward(float cur, float tgt, float step) {
  if (cur < tgt) return fminf(cur + step, tgt);
  if (cur > tgt) return fmaxf(cur - step, tgt);
  return cur;
}

void hardStop() {
  targetLeft = targetRight = 0;
  currentLeft = currentRight = 0;
  applyOutputs();
}

void setDrive(float left, float right, const char *label) {
  targetLeft  = constrain(left,  -100.0f, 100.0f);
  targetRight = constrain(right, -100.0f, 100.0f);
  stateName   = label;
  lastCommandMs = millis();
}

void setMagnet(bool on) {
  magnetOn = on;
  if (on) { magnetOnSinceMs = millis(); magnetTimedOut = false; }
  digitalWrite(MAGNET_PIN, (on == MAGNET_ACTIVE_HIGH) ? HIGH : LOW);
}

float extensionPct() {
  float span = ARM_LOWER_ANGLE - ARM_STOW_ANGLE;
  if (fabsf(span) < 1.0f) return 0;
  return constrain((armCurrent - ARM_STOW_ANGLE) / span * 100.0f, 0.0f, 100.0f);
}

// ---------------------------------------------------------------------
//  Commands (shared by HTTP and BLE)
// ---------------------------------------------------------------------
Result doMove(String dir, int speed) {
  if (estop) return {423, "emergency stop active"};
  dir.toLowerCase();
  speed = constrain(speed, 0, 100);
  float turn = speed * TURN_SCALE;

  if      (dir == "forward"  || dir == "up")                  setDrive( speed,  speed, "forward");
  else if (dir == "backward" || dir == "down" || dir == "back") setDrive(-speed, -speed, "backward");
  else if (dir == "left")                                     setDrive(-turn,   turn,  "left");
  else if (dir == "right")                                    setDrive( turn,  -turn,  "right");
  else if (dir == "stop")                                     setDrive(0, 0, "stop");
  else return {400, "dir must be forward|backward|left|right|stop"};

  sweeping = false;
  if (DEBUG_SERIAL) Serial.printf("move %s @ %d%%\n", dir.c_str(), speed);
  return RES_OK;
}

Result doDrive(float left, float right) {
  if (estop) return {423, "emergency stop active"};
  setDrive(left, right, (left == 0 && right == 0) ? "stop" : "custom");
  sweeping = false;
  return RES_OK;
}

Result doEstop() {
  estop = true;
  sweeping = false;
  hardStop();
  armTarget = armCurrent;                 // freeze the arm where it is
  if (ESTOP_RELEASES_MAGNET) setMagnet(false);
  stateName = "emergency-stop";
  if (DEBUG_SERIAL) Serial.println("EMERGENCY STOP");
  return RES_OK;
}

Result doResume() {
  estop = false;
  stateName = "stop";
  lastCommandMs = millis();
  if (DEBUG_SERIAL) Serial.println("Resumed");
  return RES_OK;
}

Result doArmPreset(String name) {
  if (estop) return {423, "emergency stop active"};
  name.toLowerCase();
  float a;
  if      (name == "stow")                 a = ARM_STOW_ANGLE;
  else if (name == "raise")                a = ARM_RAISE_ANGLE;
  else if (name == "bin" || name == "over_bin" || name == "overbin") { a = ARM_BIN_ANGLE; name = "bin"; }
  else if (name == "lower")                a = ARM_LOWER_ANGLE;
  else return {400, "pos must be lower|raise|bin|stow"};
  armTarget = constrain(a, ARM_MIN_ANGLE, ARM_MAX_ANGLE);
  armPosName = name;
  return RES_OK;
}

Result doArmAngle(float angle) {
  if (estop) return {423, "emergency stop active"};
  armTarget = constrain(angle, ARM_MIN_ANGLE, ARM_MAX_ANGLE);
  armPosName = "custom";
  return RES_OK;
}

Result doMagnet(String state) {
  state.toLowerCase();
  if (state == "off") { setMagnet(false); return RES_OK; }
  bool wantOn;
  if      (state == "on")     wantOn = true;
  else if (state == "toggle") wantOn = !magnetOn;
  else return {400, "state must be on|off|toggle"};
  if (wantOn && estop) return {423, "emergency stop active"};
  setMagnet(wantOn);
  return RES_OK;
}

Result doSweep(String state) {
  state.toLowerCase();
  if (state == "start") {
    if (estop) return {423, "emergency stop active"};
    if (METAL_DIGITAL_PIN < 0) return {400, "metal sensor disabled"};
    metalFound = false;
    sweeping = true;
    sweepStartMs = millis();
    setDrive(SWEEP_SPEED, SWEEP_SPEED, "sweep");
    return RES_OK;
  }
  if (state == "stop") {
    if (sweeping) { sweeping = false; setDrive(0, 0, "stop"); }
    return RES_OK;
  }
  return {400, "state must be start|stop"};
}

// Text command parser (used by Bluetooth)
Result runCommand(String line) {
  line.trim();
  line.toLowerCase();
  String t[4];
  int n = 0, start = 0;
  while (n < 4 && start < (int)line.length()) {
    int sp = line.indexOf(' ', start);
    if (sp < 0) sp = line.length();
    if (sp > start) t[n++] = line.substring(start, sp);
    start = sp + 1;
  }
  if (n == 0) return {400, "empty command"};

  const String &c = t[0];
  if (c == "move")   return doMove(t[1], n > 2 ? t[2].toInt() : DEFAULT_SPEED);
  if (c == "drive")  return (n >= 3) ? doDrive(t[1].toFloat(), t[2].toFloat()) : Result{400, "drive needs left right"};
  if (c == "arm")    return (t[1] == "angle") ? doArmAngle(t[2].toFloat()) : doArmPreset(t[1]);
  if (c == "magnet") return doMagnet(t[1]);
  if (c == "sweep")  return doSweep(t[1]);
  if (c == "stop")   return doEstop();
  if (c == "resume") return doResume();
  return {400, "unknown command"};
}

